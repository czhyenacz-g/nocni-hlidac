# Discord OAuth login (viz TECH_DESIGN.md "Discord login") — jen identita
# hráče (login/logout/kdo je přihlášený), zatím žádný leaderboard, žádné
# ukládání výsledků, žádná DB. Bez těchto proměnných hra dál funguje beze
# změny (login jen tiše no-opne na "?auth=config_error"), jen jde bez configu
# hrát bez přihlášení, viz akceptační kritérium "hra jde spustit i bez loginu".

# Discord Developer Portal (https://discord.com/developers/applications) ->
# tvoje aplikace -> OAuth2 -> Client ID.
DISCORD_CLIENT_ID=

# Discord Developer Portal -> OAuth2 -> Client Secret. NIKDY nekomitovat
# skutečnou hodnotu, jen do lokálního/Vercel env.
DISCORD_CLIENT_SECRET=

# Musí PŘESNĚ odpovídat jednomu z "Redirects" v Discord Developer Portal ->
# OAuth2 -> Redirects, jinak Discord odmítne login s "Invalid OAuth2
# redirect_uri". Lokálně: http://localhost:3000/api/auth/callback
# Produkce: https://nocni-hlidac.vercel.app/api/auth/callback
DISCORD_REDIRECT_URI=

# Podepisuje session cookie (viz lib/auth/session.ts) — bez něj se
# přihlášení tiše neprovede (žádná nepodepsaná/padělatelná session). Vygeneruj
# např. `openssl rand -base64 32`.
AUTH_SECRET=

# Soukromé VPS API pro žebříček hlídačů (viz TECH_DESIGN.md "VPS API
# specifikace") — STEJNÝ princip jako osmaliga.cz -> project-hub-api: Vercel
# appka nemá přímé DB připojení, jen volá tenhle API, ten mluví s DB. Bez
# těchto proměnných /leaderboard spadne na mock data a survive-night/death
# volání se tiše no-opnou (202) — hra funguje beze změny (viz lib/hubClient.ts).
# Lokálně např. http://localhost:3001, produkce vlastní VPS doména.
NOCNI_HLIDAC_API_URL=

# Sdílený token posílaný jako `Authorization: Bearer <token>` (viz
# lib/hubClient.ts). NIKDY nekomitovat skutečnou hodnotu, jen do lokálního/
# Vercel env — VPS API strana musí mít stejnou hodnotu nastavenou u sebe.
NOCNI_HLIDAC_API_TOKEN=

# Cross-origin Discord OAuth pro itch.io (viz lib/config/apiOrigin.ts,
# lib/http/cors.ts, lib/auth/returnTargets.ts) — hra může běžet vnořená na
# itch.io, kde `window.location.origin` NENÍ origin téhle appky. Bez těchto
# proměnných hra dál funguje na vlastním originu (localhost/vercel doména)
# beze změny — jen cross-origin (itch.io) login/API volání by bez nich
# nefungovalo.

# Veřejný origin, na kterém běží tahle appka (žádné koncové lomítko) — jediný
# zdroj pravdy pro absolutní fetch/OAuth URL na klientovi, ať se v produkci
# nikdy nehádá z window.location.origin (na itch.io by to bylo špatně).
# Produkce: https://nocni-hlidac.cz
NEXT_PUBLIC_API_ORIGIN=

# Přesné origins (protocol+host, žádné koncové lomítko, čárkou oddělené),
# kterým server povolí credentialed CORS požadavky (viz lib/http/cors.ts).
# Lokální vývoj má http://localhost:3000 vždy automaticky povolený navíc.
# Příklad produkce: https://nocni-hlidac.cz,https://<konkrétní-itch-origin>
AUTH_ALLOWED_ORIGINS=

# Kam přesměrovat/postMessage-nout po OAuth pro "web" cíl (viz
# lib/auth/returnTargets.ts) — bez nastavení spadá na
# "https://nocni-hlidac.cz".
AUTH_RETURN_WEB_URL=

# Kam přesměrovat/postMessage-nout po OAuth pro "itch" cíl (popup flow, viz
# zadání "6. Popup OAuth flow") — PŘESNÝ origin/URL stránky na itch.io, kde
# hra běží. Bez nastavení spadá zpátky na AUTH_RETURN_WEB_URL (bezpečný
# fallback, ne prázdný/rozbitý redirect).
AUTH_RETURN_ITCH_URL=

# Odkud tenhle konkrétní build hry běží (viz zadání "Logování hráčské
# aktivity" — "5. Volání při spuštění hry", lib/activity/activityClient.ts)
# — čistě diagnostická hodnota poslaná při startu hry na
# /api/player/activity/game-start, NEDÁVÁ žádná oprávnění. Povolené hodnoty:
# web / itch / local-export. Výchozí (nenastaveno) je "web" — pro samostatný
# lokální export nastav "local-export", pro itch.io build "itch".
NEXT_PUBLIC_GAME_CLIENT=web

# Volitelné číslo/label verze tohoto konkrétního buildu (max 64 znaků) —
# posílá se spolu s NEXT_PUBLIC_GAME_CLIENT, jen diagnostika pro /admin.
NEXT_PUBLIC_BUILD_VERSION=
